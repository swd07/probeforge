# ProbeForge behind Caddy with automatic HTTPS (Let's Encrypt). The domain comes from deploy/.env (PROBEFORGE_DOMAIN).
# No ACME account e-mail: certificates are issued and renewed without one (an empty e-mail directive is a config
# error, so there is none). docs/DEPLOY.md has the steps.

# Security headers for every site. The page loads only its own script; inline styles are needed by the drawing (an
# SVG with a <style> element) and by React style attributes; data: images by the favicon. The WebSocket is same-origin
# (wss:// listed for browsers that do not count it as 'self').
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://{$PROBEFORGE_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}

{$PROBEFORGE_DOMAIN} {
	import security_headers
	encode zstd gzip
	# visitors only once the app has simulated everything in advance (/api/ready, D62); until then the starting page.
	# The check sends Host: localhost, which the app's host allow-list always accepts.
	reverse_proxy app:8000 {
		health_uri /api/ready
		health_interval 5s
		health_timeout 4s
		health_headers {
			Host localhost
		}
	}
	handle_errors 502 503 {
		root * /srv/status
		rewrite * /starting.html
		file_server
	}
}

# Your personal website later: point its domain at the server, put the files in deploy/site/, uncomment, then
#   sudo docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
