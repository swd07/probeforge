# deploy/.env on the server (not secret; read by docker compose for the settings below). Copy to deploy/.env.
PROBEFORGE_DOMAIN=demo.example.org
PROBEFORGE_TAG=latest
PROBEFORGE_ENV_FILE=/etc/probeforge/probeforge.env
PROBEFORGE_CADDYFILE=Caddyfile
# IP-only test: PROBEFORGE_CADDYFILE=Caddyfile.http
