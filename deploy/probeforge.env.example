# The app's env file on the server: /etc/probeforge/probeforge.env, owned by root, mode 600 (docs/DEPLOY.md).
# Copy this file there and fill it in on the server. Never commit the filled-in file, never paste it anywhere.

# The Meta API key for the public demo (set on the server only).
META_API_KEY=

# A random secret for the session tokens, so they stay valid across a restart:  openssl rand -hex 32
PROBEFORGE_TOKEN_SECRET=

# The demo's own origin and host name: only these are accepted (WebSocket Origin check, HTTP Host check).
PROBEFORGE_ALLOWED_ORIGINS=https://demo.example.org
PROBEFORGE_ALLOWED_HOSTS=demo.example.org

# IP-only test before the domain points here (with PROBEFORGE_CADDYFILE=Caddyfile.http in deploy/.env):
# PROBEFORGE_ALLOWED_ORIGINS=http://203.0.113.10
# PROBEFORGE_ALLOWED_HOSTS=203.0.113.10

# An approval card waits this long for its answer (public default 120 s); the hosted demo gives readers 5 minutes.
PROBEFORGE_APPROVAL_TIMEOUT_S=300

# Spend limits stay at their defaults unless set here: PROBEFORGE_PUBLIC_TOTAL_USD (30), PROBEFORGE_DEMO_DAILY_USD (5).
# The start-up warm-up (D62) is on in public mode; PROBEFORGE_WARM_AT_START=0 turns it off (visitors then wait on first use).
